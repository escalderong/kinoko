<h3 class="text-lg font-bold"><%= t("app.preferences.title") %></h3>

<%= form_with url: app_preferences_path, method: :patch, scope: :user, data: { turbo_frame: "modal" } do |form| %>
  <fieldset class="fieldset mt-4">
    <legend class="fieldset-legend"><%= t("app.preferences.language") %></legend>

    <label class="label">
      <%= form.radio_button :locale, "en", class: "radio radio-primary", checked: current_user.locale == "en" %>
      <%= t("app.preferences.locales.en") %>
    </label>

    <label class="label">
      <%= form.radio_button :locale, "es", class: "radio radio-primary", checked: current_user.locale == "es" %>
      <%= t("app.preferences.locales.es") %>
    </label>
  </fieldset>

  <div class="modal-action">
    <%= form.submit t("app.preferences.save"), class: "btn btn-primary" %>
  </div>
<% end %>
