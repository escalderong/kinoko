div class="card bg-base-100 border border-base-300" data-modifier-group-id=group.id
  div class="card-body gap-3"
    div class="flex items-center justify-between"
      div class="flex items-center gap-2"
        span class="font-medium" = group.name
        - if group.is_required
          span class="badge badge-sm badge-neutral" = t("app.products.modifier_groups.required")
      div class="flex items-center gap-1"
        button type="button" class="btn btn-ghost btn-xs btn-square" onclick="edit_modifier_group_#{group.id}_modal.showModal()"
          = icon("pen", class: "text-xs")
        = button_to app_products_item_modifier_group_path(product, group), method: :delete, class: "btn btn-ghost btn-xs btn-square text-error", form: { class: "contents", data: { turbo_confirm: t("app.products.modifier_groups.delete_confirm") } } do
          = icon("trash", class: "text-xs")
    - modifiers = group.modifiers.to_a
    - if modifiers.any?
      ul class="list"
        = render partial: "app/products/items/modifier", collection: modifiers, as: :modifier, locals: { product: product, group: group }
    button type="button" class="btn btn-ghost btn-sm justify-start" onclick="new_modifier_#{group.id}_modal.showModal()"
      = icon("plus", class: "text-xs")
      = t("app.products.modifiers.new")

  = render layout: "shared/modal", locals: { id: "edit_modifier_group_#{group.id}_modal", title: t("app.products.modifier_groups.edit") } do
    = form_with url: app_products_item_modifier_group_path(product, group), method: :patch do
      = render "app/products/items/modifier_group_fields", group: group
      div class="modal-action"
        button type="submit" class="btn btn-primary" = t("app.products.modifier_groups.save")

  = render layout: "shared/modal", locals: { id: "new_modifier_#{group.id}_modal", title: t("app.products.modifiers.new") } do
    = form_with url: app_products_item_modifier_group_modifiers_path(product, group), method: :post do
      = render "app/products/items/modifier_fields", modifier: Modifier.new
      div class="modal-action"
        button type="submit" class="btn btn-primary" = t("app.products.modifiers.create")
