/ daisyUI modal wrapper. Pass `id` and `title`; yield the form/fields as the body.
dialog id=id class="modal"
  div class="modal-box"
    form method="dialog"
      button class="btn btn-circle btn-ghost absolute right-3 top-3" aria-label=t("app.modal.close")
        = icon("xmark")
    h3 class="font-bold text-lg pb-3 mb-4 border-b border-base-300" = title
    = yield
  form method="dialog" class="modal-backdrop"
    button = t("app.modal.close")
